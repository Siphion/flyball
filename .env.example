# Upstream OpenAI-compatible server that actually runs the model.
FLYBALL_UPSTREAM=http://127.0.0.1:8081
# Address flyballd binds. Keep it local unless you know what you are doing.
FLYBALL_HOST=127.0.0.1
FLYBALL_PORT=8080
# Forwarded to the upstream as a bearer token. Leave empty if it needs none.
FLYBALL_UPSTREAM_API_KEY=
# Required from clients when set. Empty means no authentication.
FLYBALL_API_KEY=
# off | shadow | active  (see docs/modes.md)
FLYBALL_MODE=off
# Where decision and outcome logs are written. Excluded from git.
FLYBALL_DATA_DIR=./data
# Share of conversations that receive decisions in active mode; the rest are the control arm.
FLYBALL_AB_SHARE=0.5

# The server and the model (see docs/modes.md). auto | llama.cpp | openai
FLYBALL_SERVER=auto
# A model profile by id, instead of matching the model id the server reports.
FLYBALL_PROFILE=
# A JSON file of extra or changed profiles.
FLYBALL_PROFILES=
# The level of a request that names none, when the server sets its own default
# (for example llama-server --reasoning-effort medium).
FLYBALL_DEFAULT_LEVEL=

# Gate A, learned: a System 1 picks each request's reasoning level.
FLYBALL_GATE_A=off
# The Gate A model; empty means the one in the model's profile.
FLYBALL_GATE_A_ARTIFACT=
# respect | ceiling (Gate A may only lower a level the client chose)
FLYBALL_GATE_A_CLIENT_EFFORT=respect
FLYBALL_GATE_A_TIMEOUT_MS=150
# A System One server (Laya's, Jev), for backends that ask one.
FLYBALL_SYSTEMONE_URL=
FLYBALL_SYSTEMONE_API_KEY=

# Gate B, the governor (active mode only; needs the server's probe action).
FLYBALL_GOVERNOR=off
# Overrides of the profile's operating point; leave empty to use the profile's.
FLYBALL_GOVERNOR_CONFIDENCE=
FLYBALL_GOVERNOR_CAP=
FLYBALL_GOVERNOR_FIRST_PROBE=
FLYBALL_GOVERNOR_GROWTH=
FLYBALL_GOVERNOR_ANCHOR=
