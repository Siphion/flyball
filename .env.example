# Upstream OpenAI-compatible server that actually runs the model.
FLYBALL_UPSTREAM=http://127.0.0.1:8081
# Address flyballd binds. Keep it local unless you know what you are doing.
FLYBALL_HOST=127.0.0.1
FLYBALL_PORT=8080
# Forwarded to the upstream as a bearer token. Leave empty if it needs none.
FLYBALL_UPSTREAM_API_KEY=
# Required from clients when set. Empty means no authentication.
FLYBALL_API_KEY=
# off | shadow | active  (see docs/modes.md)
FLYBALL_MODE=off
# Where decision and outcome logs are written. Excluded from git.
FLYBALL_DATA_DIR=./data
